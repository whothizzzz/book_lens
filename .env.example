# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.


# Optional. Only needed for notebooks/06_langsmith_evaluation.ipynb - logs
# evaluation runs to LangSmith so results are viewable/comparable online.
# Get a free key at https://smith.langchain.com
LANGSMITH_API_KEY=

# Optional. Which LangSmith project the evaluation runs show up under.
# Defaults to "booklens-search-eval" if unset.
LANGSMITH_PROJECT=

# Optional. Raises Google Books API's rate limit for live web augmentation
# and scripts/fetch_supplemental_data.py. Enable the "Books API" on a
# project at https://console.cloud.google.com to get one.
GOOGLE_API_KEY=

# Optional. Raises Hugging Face Hub's rate limit for downloading the
# embedding/teacher models notebooks pull from HF - recognized
# automatically by huggingface_hub/transformers, no code reads this
# directly. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
